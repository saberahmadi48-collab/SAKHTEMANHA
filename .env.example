# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a filled-in .env.
# Every value here is validated at boot (src/config/env.validation.ts) — the API
# refuses to start with a missing or weak secret rather than running insecurely.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://bops:bops_dev_password@localhost:5432/bops?schema=public

# --- Auth -----------------------------------------------------------------
# Access token is short-lived and carries NO building scope claims (see BM-00
# rule 8: authorization is resolved server-side per request, never from a token
# the client could have obtained under an older membership).
JWT_ACCESS_SECRET=replace-me-with-32+-random-bytes-access
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=replace-me-with-32+-random-bytes-refresh
JWT_REFRESH_TTL=30d
# bcrypt cost. 12 in prod; keep >=10 locally so timing stays realistic.
PASSWORD_HASH_ROUNDS=12

# --- Redis / Queue --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) --------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bops-documents
S3_ACCESS_KEY_ID=bops
S3_SECRET_ACCESS_KEY=bops_dev_password
S3_FORCE_PATH_STYLE=true

# --- Invitations ----------------------------------------------------------
INVITATION_TTL_HOURS=168
APP_PUBLIC_URL=http://localhost:3000
