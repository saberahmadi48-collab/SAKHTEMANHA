{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    /* composite = this package is a referenced TS project. The API consumes its
       BUILT .d.ts rather than its sources, which is what keeps `rootDir` sane on
       both sides and gives incremental builds across the monorepo. */
    "composite": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"]
}
